# --- Private to this machine — never commit ---

# XRPL testnet wallet seed, generated by scripts/live-heartbeat.ts. Disposable
# and testnet-only, but a seed is a seed — regenerate rather than share it.
packages/contracts/deployments/xrpl-testnet-wallet.json

# TEE proxy configs carry the indexer DB password.
packages/tee/config/proxy/*.toml
!packages/tee/config/proxy/*.example
!packages/tee/config/proxy/extension_proxy.docker.toml

# Generated by the FCC registration scripts; contains the deployed extension id
# and instruction sender for THIS deployment.
packages/tee/config/extension.env
packages/tee/config/deploy.log
packages/tee/config/register-tee.state
packages/tee/.env
packages/tee/.env.local*

# Go build output and generated bindings
packages/tee/go/tools/pkg/contracts/*/autogen.go
packages/tee/out/
packages/tee/lib/

# Node deps inside the vendored scaffold
packages/tee/typescript/node_modules/

# Rendered video output — large binaries, regenerate with pnpm remotion render
packages/video/out/

docs/DEMO.md

# The delegated regular-key seed and the keeper's local state. The key can sign
# payouts for any estate that authorised it, so it never belongs in the repo.
packages/contracts/deployments/keeper-key.json
packages/contracts/deployments/keeper-state.json

# Will plaintexts written by seal-live.ts. The chain stores only the
# commitment; these hold the beneficiaries the whole design keeps private.
packages/contracts/deployments/will-vault-*.json
