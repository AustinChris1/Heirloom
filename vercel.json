{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --filter @heirloom/web... --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @heirloom/web build",
  "outputDirectory": "packages/web/dist",
  "rewrites": [
    {
      "source": "/da/:path*",
      "destination": "https://ctn2-data-availability.flare.network/:path*"
    },
    {
      "source": "/xrpl",
      "destination": "https://s.altnet.rippletest.net:51234/"
    },
    {
      "source": "/enclave/:path*",
      "destination": "https://sly.southafricanorth.cloudapp.azure.com/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
